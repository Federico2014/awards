{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.example.invalid/awards/awards.schema.json",
  "title": "awards",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "items"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "items": {
      "type": "array",
      "items": {
        "allOf": [
          {
            "$ref": "record.schema.json"
          },
          {
            "properties": {
              "entry": {
                "properties": {
                  "status": {
                    "enum": [
                      "announced",
                      "disputed",
                      "paid",
                      "revoked"
                    ]
                  }
                }
              }
            }
          }
        ]
      },
      "minItems": 0,
      "uniqueItems": true
    }
  }
}
