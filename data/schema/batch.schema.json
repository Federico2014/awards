{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.example.invalid/awards/batch.schema.json",
  "title": "batch",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "announced_at",
    "announcement",
    "award_ids"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[0-9]{4}-(0[1-9]|1[0-2])$"
    },
    "announced_at": {
      "type": "string",
      "format": "date"
    },
    "announcement": {
      "type": "string",
      "format": "uri",
      "pattern": "^https://[^/\\s]+(?:/[^\\s]*)?$"
    },
    "award_ids": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
      },
      "minItems": 1,
      "uniqueItems": true
    }
  }
}
