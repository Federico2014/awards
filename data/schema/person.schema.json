{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.example.invalid/awards/person.schema.json",
  "title": "person",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "name",
    "role",
    "affiliation",
    "links",
    "publication_consent",
    "recusals"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
    },
    "name": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S"
    },
    "role": {
      "enum": [
        "recipient",
        "curator",
        "verifier"
      ]
    },
    "affiliation": {
      "type": "string"
    },
    "links": {
      "type": "array",
      "items": {
        "type": "string",
        "format": "uri",
        "pattern": "^https://[^/\\s]+(?:/[^\\s]*)?$"
      },
      "minItems": 0,
      "uniqueItems": true
    },
    "publication_consent": {
      "anyOf": [
        {
          "type": "string",
          "format": "uri",
          "pattern": "^https://[^/\\s]+(?:/[^\\s]*)?$"
        },
        {
          "type": "null"
        }
      ]
    },
    "recusals": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "entry_id",
          "date",
          "reason",
          "url"
        ],
        "properties": {
          "entry_id": {
            "type": "string",
            "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
          },
          "date": {
            "type": "string",
            "format": "date"
          },
          "reason": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          },
          "url": {
            "anyOf": [
              {
                "type": "string",
                "format": "uri",
                "pattern": "^https://[^/\\s]+(?:/[^\\s]*)?$"
              },
              {
                "type": "null"
              }
            ]
          }
        }
      },
      "minItems": 0,
      "uniqueItems": true
    }
  }
}
