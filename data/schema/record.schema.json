{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.example.invalid/awards/record.schema.json",
  "title": "record",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "entry",
    "source_path",
    "citation",
    "recipients",
    "verification_record",
    "statement"
  ],
  "properties": {
    "entry": {
      "$ref": "award.schema.json"
    },
    "source_path": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S"
    },
    "citation": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S"
    },
    "recipients": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S"
    },
    "verification_record": {
      "anyOf": [
        {
          "$ref": "verification-record.schema.json"
        },
        {
          "type": "null"
        }
      ]
    },
    "statement": {
      "anyOf": [
        {
          "$ref": "statement.schema.json"
        },
        {
          "type": "null"
        }
      ]
    }
  }
}
