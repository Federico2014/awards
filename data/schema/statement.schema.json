{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.example.invalid/awards/statement.schema.json",
  "title": "statement",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "status",
    "supersedes",
    "statement",
    "authorship",
    "post_hoc"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^STMT-[a-z0-9]+(?:-[a-z0-9]+)*-v[1-9][0-9]*$"
    },
    "status": {
      "enum": [
        "active",
        "superseded"
      ]
    },
    "supersedes": {
      "anyOf": [
        {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        {
          "type": "null"
        }
      ]
    },
    "statement": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "text",
        "natural_language_source",
        "definitions_reviewed",
        "library"
      ],
      "properties": {
        "text": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "natural_language_source": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "definitions_reviewed": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "name",
              "from_library",
              "review"
            ],
            "properties": {
              "name": {
                "type": "string",
                "minLength": 1,
                "pattern": "\\S"
              },
              "from_library": {
                "type": "boolean"
              },
              "review": {
                "type": "string"
              }
            }
          },
          "minItems": 0,
          "uniqueItems": true
        },
        "library": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "name",
            "commit",
            "meets_minimum_safe_version"
          ],
          "properties": {
            "name": {
              "type": "string",
              "minLength": 1,
              "pattern": "\\S"
            },
            "commit": {
              "type": "string",
              "pattern": "^[0-9a-f]{40}$"
            },
            "meets_minimum_safe_version": {
              "type": "boolean"
            }
          }
        }
      }
    },
    "authorship": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "signatories",
        "issued_at"
      ],
      "properties": {
        "signatories": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
          },
          "minItems": 2,
          "uniqueItems": true
        },
        "issued_at": {
          "type": "string",
          "format": "date"
        }
      }
    },
    "post_hoc": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "applies",
        "third_party_source",
        "authors",
        "comparison",
        "disclosure",
        "b4_eligible",
        "b4_blocked_reason"
      ],
      "properties": {
        "applies": {
          "type": "boolean"
        },
        "third_party_source": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "used",
            "origin"
          ],
          "properties": {
            "used": {
              "type": "boolean"
            },
            "origin": {
              "type": "string"
            }
          }
        },
        "authors": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "id",
              "recusal_ok",
              "blind"
            ],
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
              },
              "recusal_ok": {
                "type": "boolean"
              },
              "blind": {
                "type": "boolean"
              }
            }
          },
          "minItems": 0,
          "uniqueItems": true
        },
        "comparison": {
          "type": "string"
        },
        "disclosure": {
          "anyOf": [
            {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "written_at",
                "original_text_source"
              ],
              "properties": {
                "written_at": {
                  "type": "string",
                  "format": "date"
                },
                "original_text_source": {
                  "type": "string",
                  "minLength": 1,
                  "pattern": "\\S"
                }
              }
            },
            {
              "type": "null"
            }
          ]
        },
        "b4_eligible": {
          "type": "boolean"
        },
        "b4_blocked_reason": {
          "type": "string"
        }
      }
    }
  }
}
