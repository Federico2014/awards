{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.example.invalid/awards/verification-record.schema.json",
  "title": "verification-record",
  "anyOf": [
    {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "repository",
        "commit",
        "toolchain",
        "theorems",
        "statement_comparison",
        "checkers",
        "environment",
        "sandbox",
        "attribution",
        "artifacts",
        "performed_by",
        "performed_at"
      ],
      "properties": {
        "repository": {
          "type": "string",
          "format": "uri",
          "pattern": "^https://[^/\\s]+(?:/[^\\s]*)?$"
        },
        "commit": {
          "type": "string",
          "pattern": "^[0-9a-f]{40}$"
        },
        "toolchain": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "language",
            "language_version",
            "library",
            "library_commit",
            "meets_minimum_safe_version"
          ],
          "properties": {
            "language": {
              "type": "string",
              "minLength": 1,
              "pattern": "\\S"
            },
            "language_version": {
              "type": "string",
              "minLength": 1,
              "pattern": "\\S"
            },
            "library": {
              "type": "string",
              "minLength": 1,
              "pattern": "\\S"
            },
            "library_commit": {
              "type": "string",
              "pattern": "^[0-9a-f]{40}$"
            },
            "meets_minimum_safe_version": {
              "type": "boolean"
            }
          }
        },
        "theorems": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "name",
              "axioms",
              "clean"
            ],
            "properties": {
              "name": {
                "type": "string",
                "minLength": 1,
                "pattern": "\\S"
              },
              "axioms": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1,
                  "pattern": "\\S"
                },
                "minItems": 0,
                "uniqueItems": true
              },
              "clean": {
                "type": "boolean"
              }
            }
          },
          "minItems": 1,
          "uniqueItems": true
        },
        "statement_comparison": {
          "anyOf": [
            {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "statement_id",
                "theorem_name",
                "result",
                "basis",
                "performed_by",
                "performed_at"
              ],
              "properties": {
                "statement_id": {
                  "type": "string",
                  "minLength": 1,
                  "pattern": "\\S"
                },
                "theorem_name": {
                  "type": "string",
                  "minLength": 1,
                  "pattern": "\\S"
                },
                "result": {
                  "enum": [
                    "equivalent",
                    "not-equivalent"
                  ]
                },
                "basis": {
                  "type": "string",
                  "minLength": 1,
                  "pattern": "\\S"
                },
                "performed_by": {
                  "type": "string",
                  "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
                },
                "performed_at": {
                  "type": "string",
                  "format": "date"
                }
              }
            },
            {
              "type": "null"
            }
          ]
        },
        "checkers": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "name",
              "version",
              "current_release",
              "result"
            ],
            "properties": {
              "name": {
                "type": "string",
                "minLength": 1,
                "pattern": "\\S"
              },
              "version": {
                "type": "string",
                "minLength": 1,
                "pattern": "\\S"
              },
              "current_release": {
                "type": "boolean"
              },
              "result": {
                "enum": [
                  "pass",
                  "fail"
                ]
              }
            }
          },
          "minItems": 2,
          "uniqueItems": true
        },
        "environment": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "arch",
            "image"
          ],
          "properties": {
            "arch": {
              "type": "string",
              "minLength": 1,
              "pattern": "\\S"
            },
            "image": {
              "type": "string",
              "minLength": 1,
              "pattern": "\\S"
            }
          }
        },
        "sandbox": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "network_disabled",
            "prebuilt_artifacts_ignored",
            "limits",
            "unprivileged_user"
          ],
          "properties": {
            "network_disabled": {
              "type": "boolean"
            },
            "prebuilt_artifacts_ignored": {
              "type": "boolean"
            },
            "limits": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "time",
                "memory"
              ],
              "properties": {
                "time": {
                  "type": "string",
                  "minLength": 1,
                  "pattern": "\\S"
                },
                "memory": {
                  "type": "string",
                  "minLength": 1,
                  "pattern": "\\S"
                }
              }
            },
            "unprivileged_user": {
              "type": "boolean"
            }
          }
        },
        "attribution": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "proof_route",
            "third_party",
            "note_zh",
            "note_en"
          ],
          "properties": {
            "proof_route": {
              "type": "string",
              "minLength": 1,
              "pattern": "\\S"
            },
            "third_party": {
              "type": "boolean"
            },
            "note_zh": {
              "type": "string"
            },
            "note_en": {
              "type": "string"
            }
          }
        },
        "artifacts": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "build_log"
          ],
          "properties": {
            "build_log": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "archive",
                "sha256",
                "bytes"
              ],
              "properties": {
                "archive": {
                  "type": "string",
                  "minLength": 1,
                  "pattern": "\\S"
                },
                "sha256": {
                  "type": "string",
                  "pattern": "^[0-9a-f]{64}$"
                },
                "bytes": {
                  "type": "integer",
                  "minimum": 1
                }
              }
            }
          }
        },
        "performed_by": {
          "type": "string",
          "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
        },
        "performed_at": {
          "type": "string",
          "format": "date"
        }
      }
    },
    {
      "type": "null"
    }
  ]
}
