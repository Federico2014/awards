# Structure template; angle-bracket placeholders intentionally fail validation.
# Record the original license here for any third-party formal statement.
repository: "<proof repository HTTPS URL>"
commit: "<40-character immutable commit>"
toolchain:
  language: Lean
  language_version: "<exact version>"
  library: mathlib
  library_commit: "<40-character immutable library commit>"
  meets_minimum_safe_version: false
theorems:
  - name: "<top-level theorem>"
    axioms: []
    clean: false
statement_comparison:
  statement_id: "STMT-<entry-id>-v1"
  theorem_name: "<top-level theorem>"
  result: not-equivalent
  basis: "<comparison including all premises and quantifier structure>"
  performed_by: "<verifier-id>"
  performed_at: "<YYYY-MM-DD>"
checkers:
  - name: "<checker-one>"
    version: "<exact version>"
    current_release: false
    result: fail
  - name: "<independent-checker-two>"
    version: "<exact version>"
    current_release: false
    result: fail
environment:
  arch: "<architecture>"
  image: "<immutable image identifier>"
sandbox:
  network_disabled: false
  prebuilt_artifacts_ignored: false
  limits:
    time: "<time limit>"
    memory: "<memory limit>"
  unprivileged_user: false
attribution:
  proof_route: "<proof route being formalized>"
  third_party: false
  note_zh: ""
  note_en: ""
artifacts:
  build_log:
    archive: "<permanent archive identifier, e.g. DOI>"
    sha256: "<64-character SHA-256>"
    bytes: 0
performed_by: "<verifier-id>"
performed_at: "<YYYY-MM-DD>"
